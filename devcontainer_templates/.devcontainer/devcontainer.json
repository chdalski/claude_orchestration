{
  "name": "${localWorkspaceFolderBasename} - Sandbox",
  // Build, resource limits, env files and read-only host binds live in
  // docker-compose.yml. docker-compose.audio.yml adds PulseAudio passthrough
  // and works on Linux only — remove it on macOS and Windows.
  "dockerComposeFile": [
    "docker-compose.yml",
    "docker-compose.audio.yml"
  ],
  "service": "sandbox",
  // Keep the container running — on the Compose path the image's own
  // command runs otherwise, and it exits immediately.
  "overrideCommand": true,
  // Use features to enable language support (https://containers.dev/features):
  "features": {
    "ghcr.io/devcontainers/features/rust:1": {},
    "ghcr.io/devcontainers/features/node:1": {
      "pnpmVersion": "latest"
    },
    "ghcr.io/devcontainers-extra/features/uv:1": {},
    "ghcr.io/devcontainers/features/go:1": {
      // Pin golangci-lint below 2.12.1: the Go feature's install script
      // fails checksum verification on golangci-lint >= 2.12.1.
      // See https://github.com/devcontainers/features/issues/1635
      "golangciLintVersion": "2.11.4"
    }
  },
  "remoteUser": "vscode",
  // Named volumes only — read-only binds belong in docker-compose.yml (see
  // there). Compose prefixes every volume with the project name
  // (<folder>_devcontainer_), so the folder name is not repeated here;
  // ${devcontainerId} keeps checkouts with the same folder name apart.
  // fish keeps its history in ~/.local/share/fish, hence that mount target.
  "mounts": [
    "source=claude-config-${devcontainerId},target=/home/vscode/.claude,type=volume",
    "source=shell-history-${devcontainerId},target=/home/vscode/.local/share/fish,type=volume",
    "source=pnpm-store-${devcontainerId},target=/home/vscode/.local/share/pnpm/store,type=volume"
  ],
  "containerEnv": {
    // uv's cache and the workspace .venv are on different filesystems, so
    // hardlinking always fails — copy without warning on every sync.
    "UV_LINK_MODE": "copy"
  },
  "workspaceFolder": "/workspace",
  "postCreateCommand": "bash /workspace/.devcontainer/post-create.sh",
  "postStartCommand": "bash /workspace/.devcontainer/post-start.sh",
  "waitFor": "postStartCommand"
}
